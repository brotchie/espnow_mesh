# CYD 4" controller / master.
# Board: ESP32-D0WD-V3 on /dev/cu.usbserial-1440, MAC B0:CB:D8:02:ED:74.
CONFIG_ESPNOW_MESH_ROLE_CONTROLLER=y
CONFIG_ESPNOW_MESH_DEVICE_ID=3
CONFIG_ESPNOW_MESH_CHANNEL=1
CONFIG_ESPNOW_MESH_SEND_RETRIES=5
CONFIG_ESPNOW_MESH_RETRY_INTERVAL_MS=120
CONFIG_ESPNOW_MESH_RELIABLE_MAX_ATTEMPTS=8
CONFIG_ESPNOW_MESH_RELIABLE_INITIAL_BACKOFF_MS=150
CONFIG_ESPNOW_MESH_RELIABLE_MAX_BACKOFF_MS=2000
CONFIG_ESPNOW_MESH_RELIABLE_RETRY_JITTER_MS=30
CONFIG_ESPNOW_MESH_RELIABLE_DEADLINE_MS=10000
CONFIG_ESPNOW_MESH_DATA_INTERVAL_MS=2000
CONFIG_ESPNOW_MESH_TIME_SYNC_INTERVAL_MS=500
CONFIG_ESPNOW_MESH_TIME_SYNC_MAX_DELAY_US=30000
CONFIG_ESPNOW_MESH_TIME_SYNC_FILTER_SHIFT=3
CONFIG_ESPNOW_MESH_TIME_SYNC_PLL_ENABLE=y
CONFIG_ESPNOW_MESH_TIME_SYNC_PLL_LOCK_SAMPLES=6
CONFIG_ESPNOW_MESH_TIME_SYNC_PLL_PHASE_GAIN_SHIFT=3
CONFIG_ESPNOW_MESH_TIME_SYNC_PLL_FREQ_GAIN_SHIFT=8
CONFIG_ESPNOW_MESH_TIME_SYNC_PLL_MAX_FREQ_PPB=100000
CONFIG_ESPNOW_MESH_TIME_SYNC_PLL_OUTLIER_US=3000
CONFIG_ESPNOW_MESH_TIME_SYNC_PLL_DELAY_MARGIN_US=5000
CONFIG_ESPNOW_MESH_TIME_SYNC_PLL_RESET_AFTER_REJECTS=8
# The CYD is not wired to the logic analyzer in the current bench.
# Leave sync output disabled so we do not drive an unknown display pin.
# CONFIG_ESPNOW_MESH_SYNC_OUTPUT_ENABLE is not set
CONFIG_ESPNOW_MESH_PAYLOAD_BYTES=64
CONFIG_ESPNOW_MESH_MAX_SATELLITES=8
CONFIG_ESPNOW_MESH_REGISTRATION_AP_ENABLE=y
CONFIG_ESPNOW_MESH_REGISTRATION_SSID="esp-now-mesh"
CONFIG_ESPNOW_MESH_REGISTRATION_PASSWORD="espnowmesh"
CONFIG_ESPNOW_MESH_REGISTRATION_MAX_CONNECTIONS=5
CONFIG_ESPNOW_MESH_REGISTRATION_LISTEN_MS=5000
CONFIG_ESPNOW_MESH_REGISTRATION_RETRY_INTERVAL_MS=15000
CONFIG_ESPNOW_MESH_REGISTRATION_SCAN_MS=300
CONFIG_ESPNOW_MESH_REGISTRATION_CONNECT_TIMEOUT_MS=10000
CONFIG_ESPNOW_MESH_REGISTRATION_HOLD_MS=1500
CONFIG_ESPNOW_MESH_EVENT_QUEUE_LEN=32
# Keep LVGL lean; the controller visualizer only uses local UI code.
# CONFIG_LV_BUILD_EXAMPLES is not set
# The CYD module reports 4 MB flash; LVGL + WiFi needs more than the 1 MB app partition.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
