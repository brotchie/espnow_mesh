# CYD 4" HIL controller / master.
# Board: ESP32-D0WD-V3 on /dev/cu.usbserial-1440, MAC B0:CB:D8:02:ED:74.
CONFIG_ESPNOW_MESH_ROLE_CONTROLLER=y
CONFIG_ESPNOW_MESH_DEVICE_ID=3
CONFIG_ESPNOW_MESH_CHANNEL=1
CONFIG_ESPNOW_MESH_SEND_RETRIES=5
CONFIG_ESPNOW_MESH_RETRY_INTERVAL_MS=120
CONFIG_ESPNOW_MESH_RELIABLE_MAX_ATTEMPTS=10
CONFIG_ESPNOW_MESH_RELIABLE_INITIAL_BACKOFF_MS=120
CONFIG_ESPNOW_MESH_RELIABLE_MAX_BACKOFF_MS=1200
CONFIG_ESPNOW_MESH_RELIABLE_RETRY_JITTER_MS=30
CONFIG_ESPNOW_MESH_RELIABLE_DEADLINE_MS=3000
CONFIG_ESPNOW_MESH_DATA_INTERVAL_MS=2000
CONFIG_ESPNOW_MESH_TIME_SYNC_INTERVAL_MS=500
CONFIG_ESPNOW_MESH_TIME_SYNC_MAX_DELAY_US=30000
CONFIG_ESPNOW_MESH_TIME_SYNC_FILTER_SHIFT=3
CONFIG_ESPNOW_MESH_TIME_SYNC_PLL_ENABLE=y
CONFIG_ESPNOW_MESH_TIME_SYNC_PLL_LOCK_SAMPLES=6
CONFIG_ESPNOW_MESH_TIME_SYNC_PLL_PHASE_GAIN_SHIFT=3
CONFIG_ESPNOW_MESH_TIME_SYNC_PLL_FREQ_GAIN_SHIFT=8
CONFIG_ESPNOW_MESH_TIME_SYNC_PLL_MAX_FREQ_PPB=100000
CONFIG_ESPNOW_MESH_TIME_SYNC_PLL_OUTLIER_US=3000
CONFIG_ESPNOW_MESH_TIME_SYNC_PLL_DELAY_MARGIN_US=5000
CONFIG_ESPNOW_MESH_TIME_SYNC_PLL_RESET_AFTER_REJECTS=8
CONFIG_ESPNOW_MESH_SYNC_OUTPUT_ENABLE=y
CONFIG_ESPNOW_MESH_SYNC_OUTPUT_GPIO=2
CONFIG_ESPNOW_MESH_SYNC_OUTPUT_PERIOD_US=100000
CONFIG_ESPNOW_MESH_SYNC_OUTPUT_HIGH_US=50000
CONFIG_ESPNOW_MESH_SYNC_OUTPUT_REQUIRE_SYNC=y
CONFIG_ESPNOW_MESH_HIL_TEST_ENABLE=y
CONFIG_ESPNOW_MESH_HIL_EXPECTED_SATELLITES=3
CONFIG_ESPNOW_MESH_HIL_CONTROLLER_START_DELAY_MS=8000
CONFIG_ESPNOW_MESH_HIL_DISCOVERY_MS=7000
CONFIG_ESPNOW_MESH_HIL_APPLY_DELAY_US=1500000
CONFIG_ESPNOW_MESH_HIL_CASE_GAP_MS=1600
CONFIG_ESPNOW_MESH_HIL_MARK_PULSE_US=20000
CONFIG_ESPNOW_MESH_HIL_RANDOM_START_CHANNEL_ENABLE=y
CONFIG_ESPNOW_MESH_HIL_RANDOM_CHANNEL_MIN=1
CONFIG_ESPNOW_MESH_HIL_RANDOM_CHANNEL_MAX=11
CONFIG_ESPNOW_MESH_HIL_REQUIRE_SOFTAP_DISCOVERY=y
CONFIG_ESPNOW_MESH_HIL_PATCH_BYTES=512
CONFIG_ESPNOW_MESH_HIL_PATCH_BLOCK_BYTES=64
CONFIG_ESPNOW_MESH_HIL_PATCH_OFFER_INTERVAL_MS=120
CONFIG_ESPNOW_MESH_HIL_PATCH_DEADLINE_MS=10000
CONFIG_ESPNOW_MESH_PAYLOAD_BYTES=64
CONFIG_ESPNOW_MESH_MAX_SATELLITES=8
CONFIG_ESPNOW_MESH_REGISTRATION_AP_ENABLE=y
CONFIG_ESPNOW_MESH_REGISTRATION_SSID="esp-now-mesh"
CONFIG_ESPNOW_MESH_REGISTRATION_PASSWORD="espnowmesh"
CONFIG_ESPNOW_MESH_REGISTRATION_MAX_CONNECTIONS=5
CONFIG_ESPNOW_MESH_REGISTRATION_LISTEN_MS=1000
CONFIG_ESPNOW_MESH_REGISTRATION_RETRY_INTERVAL_MS=3000
CONFIG_ESPNOW_MESH_REGISTRATION_SCAN_MS=120
CONFIG_ESPNOW_MESH_REGISTRATION_CONNECT_TIMEOUT_MS=5000
CONFIG_ESPNOW_MESH_REGISTRATION_HOLD_MS=700
CONFIG_ESPNOW_MESH_EVENT_QUEUE_LEN=64
# The CYD module reports 4 MB flash; keep the larger app partition for parity
# with the CYD visualizer controller profile.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
